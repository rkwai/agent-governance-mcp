{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-nature-company.dev/schemas/experiment-v1.json",
  "title": "Experiment v1",
  "description": "Preregistered and revisioned commercial experiment protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "company_id",
    "cell_id",
    "offer_version_id",
    "revision",
    "state",
    "hypothesis",
    "baseline",
    "treatment",
    "target_population",
    "metrics",
    "success_thresholds",
    "failure_thresholds",
    "stop_rules",
    "window",
    "budget",
    "permitted_actions",
    "executor_principal_ids",
    "evaluator_principal_id",
    "registered_by_principal_id",
    "registered_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": { "$ref": "#/$defs/uuid" },
    "company_id": { "$ref": "#/$defs/uuid" },
    "cell_id": { "$ref": "#/$defs/uuid" },
    "offer_version_id": { "$ref": "#/$defs/uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": ["draft", "registered", "running", "evaluating", "passed", "failed", "inconclusive", "cancelled"]
    },
    "hypothesis": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "baseline": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "treatment": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "target_population": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/metric" }
    },
    "success_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/threshold" }
    },
    "failure_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/threshold" }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/stopRule" }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": { "$ref": "#/$defs/dateTime" },
        "ends_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "budget": { "$ref": "#/$defs/budgetAmount" },
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "executor_principal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "evaluator_principal_id": { "$ref": "#/$defs/uuid" },
    "registered_by_principal_id": { "$ref": "#/$defs/uuid" },
    "registered_at": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "unitOfAccount": { "type": "string", "enum": ["money", "time", "cycles", "tries"] },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "budgetAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor"],
      "properties": {
        "unit": { "$ref": "#/$defs/unitOfAccount" },
        "currency": { "$ref": "#/$defs/currency" },
        "amount_minor": { "type": "integer", "minimum": 0 }
      },
      "allOf": [{ "$ref": "#/$defs/moneyRequiresCurrency" }]
    },
    "moneyRequiresCurrency": {
      "if": {
        "anyOf": [
          { "not": { "required": ["unit"] } },
          { "properties": { "unit": { "const": "money" } }, "required": ["unit"] }
        ]
      },
      "then": { "required": ["currency"] },
      "else": { "not": { "required": ["currency"] } }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "name", "unit", "direction"],
      "properties": {
        "metric_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 250 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 100 },
        "direction": { "enum": ["increase", "decrease", "target"] }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "operator", "value"],
      "properties": {
        "metric_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "operator": { "enum": ["gt", "gte", "eq", "lte", "lt"] },
        "value": { "type": "number" }
      }
    },
    "stopRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "condition", "effect"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "condition": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "effect": { "enum": ["pause_external_actions", "cancel_experiment", "require_founder_review"] }
      }
    }
  }
}
