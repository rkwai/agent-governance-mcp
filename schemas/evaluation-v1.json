{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-nature-company.dev/schemas/evaluation-v1.json",
  "title": "Independent Evaluation v1",
  "description": "Assessment of a frozen experiment revision by a separate evaluator principal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "company_id",
    "experiment_id",
    "experiment_revision",
    "evaluator_principal_id",
    "evaluator_run_id",
    "executor_principal_ids",
    "independence_attestation",
    "criterion_results",
    "result",
    "summary",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evaluation_id": { "$ref": "#/$defs/uuid" },
    "company_id": { "$ref": "#/$defs/uuid" },
    "experiment_id": { "$ref": "#/$defs/uuid" },
    "experiment_revision": { "type": "integer", "minimum": 1 },
    "evaluator_principal_id": { "$ref": "#/$defs/uuid" },
    "evaluator_run_id": { "$ref": "#/$defs/uuid" },
    "executor_principal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "independence_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_independent", "checked_by_substrate", "basis"],
      "properties": {
        "is_independent": { "const": true },
        "checked_by_substrate": { "const": true },
        "basis": { "enum": ["separate_principal", "human_approval", "separate_principal_and_human"] }
      }
    },
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "outcome", "observed_value", "evidence_ids"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "outcome": { "enum": ["passed", "failed", "inconclusive"] },
          "observed_value": { "type": ["string", "number", "boolean", "null"] },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/uuid" }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "outcome": { "const": "passed" } },
              "required": ["outcome"]
            },
            "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
          },
          {
            "if": {
              "properties": {
                "outcome": { "const": "failed" },
                "evidence_ids": { "maxItems": 0 }
              },
              "required": ["outcome", "evidence_ids"]
            },
            "then": { "properties": { "observed_value": { "const": 0 } } }
          }
        ]
      }
    },
    "result": { "enum": ["passed", "failed", "inconclusive"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evaluated_at": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time" }
  }
}
