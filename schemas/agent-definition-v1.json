{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-nature-company.dev/schemas/agent-definition-v1.json",
  "title": "Agent Definition v1",
  "description": "Model-neutral agent configuration. It declares compatibility and never grants authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_id",
    "version",
    "name",
    "purpose",
    "instructions",
    "declared_capabilities",
    "compatible_roles",
    "constraints",
    "input_contract",
    "output_contract"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "definition_id": { "$ref": "#/$defs/uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "declared_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "compatible_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["founder", "allocator", "cell_owner", "specialist", "evaluator", "immune", "observer"]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_self_evaluate", "may_commit_allocation", "may_change_constitution", "requires_active_lease_for_work"],
      "properties": {
        "may_self_evaluate": { "const": false },
        "may_commit_allocation": { "type": "boolean" },
        "may_change_constitution": { "const": false },
        "requires_active_lease_for_work": { "type": "boolean" }
      }
    },
    "input_contract": { "$ref": "#/$defs/ioContract" },
    "output_contract": { "$ref": "#/$defs/ioContract" },
    "supersedes_definition_id": {
      "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
    },
    "description": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "ioContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "schema_ref"],
      "properties": {
        "media_type": { "type": "string", "const": "application/json" },
        "schema_ref": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}

